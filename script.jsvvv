/* PRODUITS ET GRILLES GLASSMORPHISM */
.section-title {
    font-family: 'Orbitron', sans-serif;
    text-align: center;
    margin: 45px 0 20px;
    color: #00f2ff;
    text-shadow: 0 0 18px #00f2ff;
    letter-spacing: 3px;
}

.cat {
    font-family: 'Orbitron', sans-serif;
    font-size: 13px;
    margin: 35px 15px 10px;
    padding: 8px 16px;
    border-left: 4px solid #00f2ff;
    color: #00f2ff;
    background: rgba(10,10,25,0.85);
    display: inline-block;
    box-shadow: 0 0 15px rgba(0, 242, 255, 0.2);
}

.empty-cat-note {
    padding: 10px 15px;
    font-size: 12px;
    color: #666;
    font-style: italic;
}

.products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(165px, 1fr));
    gap: 16px;
    padding: 0 15px 20px;
    perspective: 1200px;
}

.product-card {
    background: rgba(12, 14, 28, 0.75);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(0, 242, 255, 0.35);
    clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);
    padding: 12px;
    transform-style: preserve-3d;
    transition: .35s;
    box-shadow: 0 10px 30px rgba(0,0,0,0.8);
    position: relative;
}

.product-card:hover {
    border-color: #00f2ff;
    box-shadow: 0 20px 40px rgba(0,0,0,0.9), 0 0 25px rgba(0, 242, 255, 0.5);
}

.product-card img {
    width: 100%;
    height: 135px;
    object-fit: cover;
    border-radius: 4px;
    transform: translateZ(20px);
}

.badge-rarete {
    position: absolute;
    top: 16px;
    left: 16px;
    background: rgba(0,0,0,0.85);
    border: 1px solid #ff00e5;
    color: #ff00e5;
    font-size: 8px;
    font-family: 'Orbitron', sans-serif;
    font-weight: 900;
    padding: 3px 7px;
    letter-spacing: 1px;
    box-shadow: 0 0 8px #ff00e5;
    transform: translateZ(30px);
}

.product-card h4 {
    margin: 10px 0 4px;
    font-size: 13px;
    transform: translateZ(25px);
}

.product-card .desc {
    font-size: 11px;
    color: #999;
    height: 32px;
    overflow: hidden;
    transform: translateZ(15px);
}

.product-card .price {
    color: #00f2ff;
    font-weight: 900;
    margin-top: 6px;
    transform: translateZ(25px);
    font-family: 'Orbitron', sans-serif;
    text-shadow: 0 0 10px #00f2ff;
}

.btn-reserver {
    width: 100%;
    margin-top: 8px;
    background: rgba(0, 242, 255, 0.1);
    border: 1px solid #00f2ff;
    color: #00f2ff;
    padding: 8px;
    font-family: 'Orbitron', sans-serif;
    font-size: 10px;
    font-weight: 900;
    cursor: pointer;
    transition: .2s;
    transform: translateZ(30px);
}

.btn-reserver:hover {
    background: #00f2ff;
    color: #000;
    box-shadow: 0 0 15px #00f2ff;
}

.del {
    position: absolute;
    top: 8px;
    right: 8px;
    background: #ff0044;
